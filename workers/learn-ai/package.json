{
  "name": "@altruisme/learn-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "type-check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "lessons:export": "node --experimental-strip-types scripts/sync-lessons.mjs --export-dir=dist/seo-lessons",
    "lessons:catalog": "node --experimental-strip-types scripts/sync-lessons.mjs --write-catalog",
    "lessons:sync": "node --experimental-strip-types scripts/sync-lessons.mjs",
    "build": "npm run type-check && wrangler deploy --config wrangler.jsonc --dry-run --outdir dist",
    "deploy": "npm run build && wrangler deploy --config wrangler.jsonc"
  },
  "devDependencies": {
    "typescript": "~6.0.0",
    "wrangler": "^4.36.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
