{
  "name": "acquisition",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:website": "npm run dev --workspace=@acquisition/website",
    "dev:builder": "npm run dev --workspace=@acquisition/builder",
    "dev:automatisation": "npm run dev --workspace=@acquisition/automatisation",
    "dev:observabilite": "npm run dev --workspace=@acquisition/observabilite",
    "dev:acquisition": "npm run dev --workspace=@acquisition/acquisition",
    "dev:cloud": "npm run dev --workspace=@acquisition/cloud",
    "dev:learn": "npm run dev --workspace=@acquisition/learn",
    "dev:audit": "npm run dev --workspace=@acquisition/audit",
    "build:website": "npm run build --workspace=@acquisition/website",
    "build:builder": "npm run build --workspace=@acquisition/builder",
    "build:automatisation": "npm run build --workspace=@acquisition/automatisation",
    "build:observabilite": "npm run build --workspace=@acquisition/observabilite",
    "build:acquisition": "npm run build --workspace=@acquisition/acquisition",
    "deploy:automatisation": "npm run build:automatisation && npx wrangler deploy --config apps/automatisation/wrangler.jsonc",
    "deploy:observabilite": "npm run build:observabilite && npx wrangler deploy --config apps/observabilite/wrangler.jsonc",
    "deploy:acquisition": "npm run build:acquisition && npx wrangler deploy --config apps/acquisition/wrangler.jsonc",
    "build:cloud": "npm run build --workspace=@acquisition/cloud",
    "build:learn": "npm run build --workspace=@acquisition/learn",
    "build:audit": "npm run build --workspace=@acquisition/audit",
    "test:website": "npm run test:unit --workspace=@acquisition/website",
    "test:learn": "npm run test:unit --workspace=@acquisition/learn",
    "lint:website": "npm run lint --workspace=@acquisition/website",
    "lint:learn": "npm run lint --workspace=@acquisition/learn",
    "dev:coaching": "npm run dev --workspace=@acquisition/coaching",
    "build:coaching": "npm run build --workspace=@acquisition/coaching",
    "test:coaching": "npm run test:unit --workspace=@acquisition/coaching",
    "lint:coaching": "npm run lint --workspace=@acquisition/coaching"
  }
}
