{
  "name": "altruisme-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:website": "npm run dev --workspace=@altruisme/website",
    "dev:builder": "npm run dev --workspace=@altruisme/builder",
    "dev:fondation": "npm run dev --workspace=@altruisme/fondation",
    "dev:consulting": "npm run dev --workspace=@altruisme/consulting",
    "dev:cloud": "npm run dev --workspace=@altruisme/cloud",
    "dev:learn": "npm run dev --workspace=@altruisme/learn",
    "dev:os": "npm run dev --workspace=@altruisme/os",
    "build:website": "npm run build --workspace=@altruisme/website",
    "build:builder": "npm run build --workspace=@altruisme/builder",
    "build:fondation": "npm run build --workspace=@altruisme/fondation",
    "build:consulting": "npm run build --workspace=@altruisme/consulting",
    "deploy:fondation": "npm run build:fondation && npx wrangler deploy --config apps/fondation/wrangler.jsonc",
    "deploy:consulting": "npm run build:consulting && npx wrangler deploy --config apps/consulting/wrangler.jsonc",
    "build:cloud": "npm run build --workspace=@altruisme/cloud",
    "build:learn": "npm run build --workspace=@altruisme/learn",
    "build:os": "npm run build --workspace=@altruisme/os",
    "test:website": "npm run test:unit --workspace=@altruisme/website",
    "test:learn": "npm run test:unit --workspace=@altruisme/learn",
    "test:os": "npm run test:unit --workspace=@altruisme/os",
    "lint:website": "npm run lint --workspace=@altruisme/website",
    "lint:learn": "npm run lint --workspace=@altruisme/learn",
    "lint:os": "npm run lint --workspace=@altruisme/os"
  }
}
